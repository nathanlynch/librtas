#!/bin/bash

set -eu
set -o pipefail

progname=${0##*/}

usage() {
    local status

    status="$1" ; shift

    cat <<-EOF
	Usage:
	  ${progname} [--check|--generate] <path> <dump-file>

	  --check:    check <path> against <dump-file>
	  --generate: write API/ABI dump of <path> to <dump-file>
EOF
    exit "${status}"
}

# Use ABICC[1] to catch incompatible changes in:
#
# - API at the source level
# - ABI at the object code level
#
# ABICC supports at least three types of usage; this script use the following
# pattern (lifted from the output of 'abi-compliance-checker --help'):
#
# ========================================================================
# USAGE #3 (CREATE ABI DUMPS):
#
# 1. Create XML-descriptors for two versions
# of a library (OLD.xml and NEW.xml):
#
# <version>
# 1.0
# </version>
#
# <headers>
# /path/to/headers/
# </headers>
#
# <libs>
# /path/to/libraries/
# </libs>
#
# 2. Create ABI dumps:
#
# abi-compliance-checker -lib NAME -dump OLD.xml -dump-path ./ABI-0.dump
# abi-compliance-checker -lib NAME -dump NEW.xml -dump-path ./ABI-1.dump
#
# 3. Compare ABI dumps to create report:
#
# abi-compliance-checker -l NAME -old ABI-0.dump -new ABI-1.dump
#
# ========================================================================
#
# [1] https://github.com/lvc/abi-compliance-checker

: "${builddir:=.}"
: "${srcdir:=.}"
: "${host:=x86_64-linux-gnu}"

abicc="abi-compliance-checker"

# Generate a minimal XML description to pass to abicc's '-dump' option.
generate_xml_desc() {
    local desc

    desc="$(mktemp)"
    cat > "${desc}" <<EOF
<headers>
    {RELPATH}/include/
</headers>
<libs>
    {RELPATH}/lib/
</libs>
EOF
    echo "${desc}"
}

generate() {
    local path
    local output
    local xml_descriptor

    path="$1"; shift
    output="$1"; shift

    xml_descriptor="$(generate_xml_desc)"

    "${abicc}" -relpath "${path}" \
	       -dump "${xml_descriptor}" \
	       -dump-format xml \
	       -sort \
	       -l librtas \
	       -dump-path "${output}"
}

check() {
    local path
    local old_dump
    local new_dump
    local xml_descriptor

    path="$1"; shift
    old_dump="$1"; shift

    xml_descriptor="$(generate_xml_desc)"
    new_dump="$(mktemp XXXXXX.dump)"

    # generate a dump to a temp file, to be compared to $baseline
    generate "${path}" "${new_dump}"

    "${abicc}" -l librtas -old "${old_dump}" -new "${new_dump}" \
	       -log-path /dev/null \
	       -report-path /tmp/compat_report.html

    rm -f "${new_dump}"
}

################################################################################
# main program

xmldesc=$(generate_xml_desc)

cleanup() {
    rm -f "${xmldesc}"
}

trap cleanup EXIT

test -v 1 || usage 1
opt="$1"; shift

case "${opt}" in
    --check)
	fn=check
	;;
    --generate)
	fn=generate
	;;
    --help)
	usage 0
	;;
    *)
	printf "Unknown option '%s'\n" "${opt}" >&2
	usage 1
	;;
esac

test -v 1 || usage 1; path="$1";   shift
test -v 1 || usage 1; dumpfile="$1"; shift
test -v 1 && usage 1

"${fn}" "${path}" "${dumpfile}"
